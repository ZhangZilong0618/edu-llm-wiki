# Edu-LLM-Wiki backend env. Copy to .env and fill in.
# All variables have sensible defaults; only the LLM API key is required
# to use the chat features.

# --- LLM ---
# openai | anthropic | ollama | custom
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# For ollama/custom, set the OpenAI-compatible base URL, e.g.
#   LLM_BASE_URL=http://localhost:11434/v1
LLM_BASE_URL=
LLM_MAX_TOKENS=8192
LLM_TEMPERATURE=0.3
GENERATION_LANGUAGE=zh

# --- Embeddings (local sentence-transformers) ---
EMBEDDING_ENABLED=true
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- PaddleOCR-VL (Baidu AI Studio, optional) ---
PADDLEOCR_TOKEN=
PADDLEOCR_MODEL=PaddleOCR-VL-1.6

# --- Server ---
HOST=0.0.0.0
PORT=8000
API_TOKEN=

# --- CORS (JSON list) ---
# Comma-separated; pydantic-settings will parse it.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
